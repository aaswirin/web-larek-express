{
  "openapi": "3.0.0",
  "info": {
    "title": "Web-ларёк",
    "description": "API для приложения Web-ларёк",
    "contact": {
      "email": "andrey.a.svirin@yandex.ru"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "{server}:3000",
      "variables": {
        "servers": {
          "default": "http://localhost",
          "enum": [
            "http://localhost",
            "https://weblarek.рф"
          ]
        }
      }
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Товары",
      "description": "Управление товарами"
    },
    {
      "name": "Авторизация",
      "description": "Управление авторизацией"
    },
    {
      "name": "Заказы",
      "description": "Управление заказами"
    }
  ],
  "paths": {
    "/product": {
      "get": {
        "security": [],
        "description": "Выгрузить список товаров",
        "tags": [
          "Товары"
        ],
        "responses": {
          "200": {
            "description": "Выгружен список товаров",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "$ref": "#/components/schemas/Products"
                    },
                    "total": {
                      "type": "number",
                      "example": 1
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "description": "Создать новый товар",
        "tags": [
          "Товары"
        ],
        "requestBody": {
          "description": "Новый товар",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Product"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Товар создан",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка в запросе",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          },
          "409": {
            "description": "Товар уже существует",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          }
        }
      }
    },
    "/product/{productId}": {
      "patch": {
        "description": "Обновить данные о товаре",
        "tags": [
          "Товары"
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "description": "Идентификатор товара",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/IdType"
            }
          }
        ],
        "requestBody": {
          "description": "Обновляемый товар",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Product"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Товар обновлён",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка в запросе",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          },
          "404": {
            "description": "Товар не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "description": "Удалить товар",
        "tags": [
          "Товары"
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "description": "Идентификатор товара",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/IdType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Товар удалён",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка в запросе",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          },
          "404": {
            "description": "Товар не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          }
        }
      }
    },
    "/upload": {
      "post": {
        "description": "Загрузить изображение товара",
        "tags": [
          "Товары"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Файл загружен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageType"
                }
              }
            }
          },
          "400": {
            "description": "В запросе нет файла",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          },
          "500": {
            "description": "Ошибка сервера",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "security": [],
        "description": "Создать пользователя",
        "tags": [
          "Авторизация"
        ],
        "requestBody": {
          "description": "Новый пользователь",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Пользователь создан",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "$ref": "#/components/schemas/SuccessType"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    },
                    "accessToken": {
                      "$ref": "#/components/schemas/TokenType"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Ошибка в запросе",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          },
          "409": {
            "description": "Товар уже существует",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "security": [],
        "description": "Авторизация",
        "tags": [
          "Авторизация"
        ],
        "requestBody": {
          "description": "Авторизировать пользователя",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "$ref": "#/components/schemas/EMailType"
                  },
                  "password": {
                    "$ref": "#/components/schemas/PasswordType"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Пользователь создан",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "$ref": "#/components/schemas/SuccessType"
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "$ref": "#/components/schemas/UserNameType"
                        },
                        "email": {
                          "$ref": "#/components/schemas/EMailType"
                        },
                        "accessToken": {
                          "$ref": "#/components/schemas/TokenType"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Пользователь не авторизован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/user": {
      "get": {
        "description": "Получить пользователя",
        "tags": [
          "Авторизация"
        ],
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "description": "Токен авторизации",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TokenType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Пользователь отдан",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "$ref": "#/components/schemas/SuccessType"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Пользователь не авторизован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          },
          "404": {
            "description": "Пользователь не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "security": [],
        "description": "Выход",
        "tags": [
          "Авторизация"
        ],
        "parameters": [
          {
            "name": "refreshToken",
            "in": "cookie",
            "description": "Токен авторизации",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TokenType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Пользователь вышел",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "$ref": "#/components/schemas/SuccessType"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          },
          "404": {
            "description": "Пользователь не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/token": {
      "get": {
        "security": [],
        "description": "Обновить токен",
        "tags": [
          "Авторизация"
        ],
        "parameters": [
          {
            "name": "refreshToken",
            "in": "cookie",
            "description": "Токен авторизации",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TokenType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Токен обновлён",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "$ref": "#/components/schemas/SuccessType"
                    },
                    "accessToken": {
                      "$ref": "#/components/schemas/TokenType"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Пользователь не авторизован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          },
          "404": {
            "description": "Пользователь не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          }
        }
      }
    },
    "/order": {
      "post": {
        "security": [],
        "description": "Создать новый Заказ",
        "tags": [
          "Заказы"
        ],
        "requestBody": {
          "description": "Новый заказ",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Order"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Товар создан",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка в запросе",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          },
          "409": {
            "description": "Товар уже существует",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IdType": {
        "type": "string",
        "description": "Идентификатор",
        "required": true,
        "example": "6919e442b083b9c31d33ef2f",
        "format": "ObjectId",
        "minLength": 24,
        "maxLength": 24,
        "pattern": "^[a-z\\d]{24}$"
      },
      "UserNameType": {
        "type": "string",
        "description": "Имя пользователя",
        "required": true,
        "example": "Ванька Жуков",
        "minLength": 2,
        "maxLength": 30
      },
      "EMailType": {
        "type": "string",
        "description": "EMail пользователя",
        "required": true,
        "example": "grandfather@village.рф",
        "pattern": "?:[a-z0-9!#$%&'*+\\x2f=?^_`\\x7b-\\x7d~\\x2d]+(?:\\.[a-z0-9!#$%&'*+\\x2f=?^_`\\x7b-\\x7d~\\x2d]+)*|\"(?:[\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x21\\x23-\\x5b\\x5d-\\x7f]|\\\\[\\x01-\\x09\\x0b\\x0c\\x0e-\\x7f])*\")@(?:(?:[a-z0-9](?:[a-z0-9\\x2d]*[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9\\x2d]*[a-z0-9])?|\\[(?:(2(5[0-5]|[0-4][0-9])|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(?:(2(5[0-5]|[0-4][0-9])|1[0-9][0-9]|[1-9]?[0-9])|[a-z0-9\\x2d]*[a-z0-9]:(?:[\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x21-\\x5a\\x53-\\x7f]|\\\\[\\x01-\\x09\\x0b\\x0c\\x0e-\\x7f])+)]"
      },
      "PhoneType": {
        "type": "string",
        "description": "Телефон пользователя",
        "required": true,
        "example": "+7(123)456-78-90",
        "pattern": "^((8|\\+7)[- ]?)?(\\(?\\d{3}\\)?[- ]?)?[\\d\\- ]{7,10}$"
      },
      "PasswordType": {
        "type": "string",
        "description": "Пароль",
        "required": true,
        "example": "123_%fgRT-321",
        "minLength": 2,
        "pattern": "^(?=.*\\d)(?=.*[a-z])(?=.*[A-Z])(?=.*\\W).{8,}$"
      },
      "TokenType": {
        "type": "string",
        "description": "Token для авторизации",
        "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"
      },
      "ImageType": {
        "type": "object",
        "required": true,
        "description": "Изображение товара",
        "properties": {
          "fileName": {
            "type": "string",
            "required": true,
            "description": "Имя файла",
            "example": "/images/Shell.png"
          },
          "originalName": {
            "type": "string",
            "required": true,
            "description": "Название файла",
            "example": "Shell.png"
          }
        }
      },
      "SuccessType": {
        "type": "boolean",
        "description": "Операция успешно выполнена",
        "example": true
      },
      "Product": {
        "type": "object",
        "description": "Товар",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/IdType"
          },
          "title": {
            "type": "string",
            "description": "Название",
            "required": true,
            "example": "+3 часа в сутках",
            "minLength": 8,
            "maxLength": 30
          },
          "description": {
            "type": "string",
            "description": "Описание",
            "required": true,
            "example": "Если планируете решать задачи в тренажёре, берите два."
          },
          "category": {
            "type": "string",
            "description": "Категория",
            "required": true,
            "example": "софт-скил",
            "enum": [
              "софт-скил",
              "хард-скил",
              "другое",
              "дополнительное",
              "кнопка"
            ]
          },
          "price": {
            "type": "number",
            "example": 751
          },
          "image": {
            "$ref": "#/components/schemas/ImageType"
          }
        }
      },
      "Products": {
        "type": "array",
        "description": "Список товаров",
        "items": {
          "$ref": "#/components/schemas/Product"
        }
      },
      "User": {
        "type": "object",
        "description": "Пользователь",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/IdType"
          },
          "name": {
            "$ref": "#/components/schemas/UserNameType"
          },
          "email": {
            "$ref": "#/components/schemas/EMailType"
          },
          "password": {
            "$ref": "#/components/schemas/PasswordType"
          }
        }
      },
      "Order": {
        "type": "object",
        "description": "Заказ",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/IdType"
          },
          "payment": {
            "type": "string",
            "description": "Тип оплаты",
            "required": true,
            "enum": [
              "card'",
              "online"
            ]
          },
          "email": {
            "$ref": "#/components/schemas/EMailType"
          },
          "phone": {
            "$ref": "#/components/schemas/PhoneType"
          },
          "address": {
            "type": "string",
            "description": "Адрес",
            "required": true
          },
          "total": {
            "type": "number",
            "description": "Сумма заказа",
            "required": true
          },
          "items": {
            "type": "array",
            "description": "Сумма заказа",
            "required": true,
            "items": {
              "$ref": "#/components/schemas/IdType"
            }
          }
        }
      },
      "APIError": {
        "type": "object",
        "description": "Сообщение об ошибке",
        "properties": {
          "message": {
            "type": "string",
            "description": "Текст ошибки",
            "required": true,
            "example": "Подробный текст ошибки"
          }
        }
      }
    }
  }
}